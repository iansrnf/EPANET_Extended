{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Server (pnpm)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Next.js: Client (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Next.js: Full Debug (Chrome)",
      "configurations": [
        "Next.js: Server (pnpm)",
        "Next.js: Client (Chrome)"
      ]
    }
  ]
}
